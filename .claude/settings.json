{
  "permissions": {
    "allow": [
      "Bash(sqlite3 data/catalog.db \".schema collections\")",
      "Bash(python app.py)"
    ]
  },
  "mcpServers": {
    "excalidraw": {
      "command": "node",
      "args": [
        "/path/to/excalidraw-mcp-app/dist/index.js",
        "--stdio"
      ]
    }
  }
}
